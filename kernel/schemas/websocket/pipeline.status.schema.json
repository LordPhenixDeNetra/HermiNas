{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herminas.dev/schemas/websocket/pipeline.status.schema.json",
  "title": "pipeline.status payload",
  "description": "Mirrors dataplane.proto's PipelineStats plus a lifecycle state, pushed by the pipeline manager (M3.2).",
  "type": "object",
  "required": ["pipeline_id", "state"],
  "properties": {
    "pipeline_id": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["starting", "running", "paused", "stopped", "error"]
    },
    "events_in": { "type": "integer", "minimum": 0 },
    "events_out": { "type": "integer", "minimum": 0 },
    "events_error": { "type": "integer", "minimum": 0 },
    "p99_latency_ms": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": false
}
